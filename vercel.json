{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
